{
  "ConnectionStrings": {
    "DefaultConnection": "CONFIGURED-IN-USER-SECRETS"
  },
  "JwtSettings": {
    "SecretKey": "CONFIGURED-IN-USER-SECRETS",
    "Issuer": "EShop.API",
    "Audience": "EShop.Client",
    "ExpiryHours": "8"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "https://app.eshop.com"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
